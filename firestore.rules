rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verified @smsalesinc.com users only. Published ok() — unchanged.
    function ok() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@smsalesinc[.]com$');
    }

    // ── Old top-level collections — READ-ONLY during the 7-day rollback window.
    // Data relocated to companies/smsales/* on 2026-07-22. Kept readable as a
    // rollback net; writes denied so nothing new lands here. Removed at Step 9.
    match /quotes/{id} { allow read: if ok(); allow write: if false; }
    match /meta/{id}   { allow read: if ok(); allow write: if false; }

    // ── New company-scoped layout (live). (dispatches is written server-side
    // via IAM, which bypasses rules, so it is intentionally NOT exposed here.)
    match /companies/smsales/quotes/{id}    { allow read, write: if ok(); }
    match /companies/smsales/customers/{id} { allow read, write: if ok(); }
    match /companies/smsales/meta/{id}      { allow read, write: if ok(); }

    // Deny-by-default: anything without an explicit allow above is denied.
  }
}
